learn-go should match snapshot:
  1: |
    apiVersion: helm.toolkit.fluxcd.io/v2
    kind: HelmRelease
    metadata:
      name: learn-go
      namespace: flux-system
    spec:
      chart:
        spec:
          chart: ./k8s/chart
          sourceRef:
            kind: GitRepository
            name: learn-go
            namespace: flux-system
      install:
        createNamespace: true
        remediation:
          retries: -1
      interval: 30m
      maxHistory: 2
      targetNamespace: default
      uninstall:
        keepHistory: false
      upgrade:
        cleanupOnFail: true
        remediation:
          retries: 3
      values:
        env:
          variables:
            VARIABLES_THAT_SHOULD_BE_PRINTED: LOG_LEVEL EVENT_THRESHOLD NODE_ENV PORT REDIS_DB REDIS_HOST REDIS_PORT STORAGE_DRIVER
        fullnameOverride: learn-go
        image:
          repository: ghcr.io/dxas90/learn-go
