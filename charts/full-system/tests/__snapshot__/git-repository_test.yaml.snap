learn-go should match snapshot:
  1: |
    apiVersion: source.toolkit.fluxcd.io/v1
    kind: GitRepository
    metadata:
      name: learn-go
      namespace: flux-system
    spec:
      ignore: |
        # exclude
        /*
        # include
        !k8s/
      interval: 30m
      ref:
        branch: main
      url: https://github.com/dxas90/learn-go.git
